output HEADLESS-1 {
    pos 0,0
    mode 3000x1500@75Hz
    scale 1.5
}

output WL-1 {
    pos 0,0
    mode 1200x700
    scale 1.5
}

input * events disabled
input "4660:1:kdt_test_keyboard" events enabled
input "4660:2:kdt_test_mouse" events enabled

input "4660:2:kdt_test_mouse" accel_profile flat

input type:keyboard {
    xkb_layout us
}

focus_follows_mouse no
focus_on_window_activation focus
for_window [title=".*"] floating enable, move position 10 10
swaybg_command -
swaynag_command -

bar {
    position bottom
}
